# Скопируйте в .env и заполните. Файл .env в git не попадает.

PORT=3000
# Адрес сайта снаружи (https://домен). На него ЮKassa возвращает клиента после оплаты.
BASE_URL=http://localhost:3000
STUDIO_NAME=I love stretch
# Часовой пояс студии: по нему считаются слоты и «сегодня»
STUDIO_TZ=Asia/Omsk

# Расписание и цены
OPEN_HOUR=9
CLOSE_HOUR=21
PEAK_FROM=17
PRICE_DAY=800
PRICE_PEAK=1000
# Сколько минут держим слот до оплаты: 30 для ЮKassa, 120 для перевода
HOLD_MINUTES=30
HORIZON_DAYS=60
MAX_HOURS=8
# Бронь блоками по столько часов (09–11, 11–13, …)
SLOT_HOURS=2

# Календарь: memory (для разработки, без Google) или google
CALENDAR_DRIVER=memory
# Для google:
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
# Цвета событий: 5 = жёлтый «Банан» (ждёт оплаты), 10 = зелёный «Базилик» (оплачено)
PENDING_COLOR_ID=5
PAID_COLOR_ID=10
SWEEP_INTERVAL_SEC=300

# Оплата:
#   yookassa  настоящая ЮKassa (нужны два ключа ниже)
#   fake      имитация для разработки, в production запрещена
#   transfer  перевод по реквизитам, администратор подтверждает цветом события
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1, если в магазине ЮKassa подключены чеки (54-ФЗ). Код НДС: 1 = без НДС
YOOKASSA_RECEIPT=0
YOOKASSA_VAT_CODE=1

# Реквизиты: нужны только при PAYMENT_PROVIDER=transfer
REQUISITES_RECIPIENT=
REQUISITES_ACCOUNT=
REQUISITES_BANK=

# Письма клиентам (если пусто, письма печатаются в консоль). Почта на Mail.ru: smtp.mail.ru, 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Куда приходит «оплата прошла». Пусто — на ящик SMTP_USER
ADMIN_EMAIL=

# Уведомления администратору в Telegram (если пусто, печатаются в консоль)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1, если сервер стоит за nginx или другим прокси (чтобы лимиты считались по реальному IP)
TRUST_PROXY=0

# Инструкция в письме клиенту после оплаты
VENUE_ADDRESS=Омск, ул. Фрунзе, 1 корпус 4, 11 этаж, помещение 1131
VENUE_PHONE=8 913 658-19-00
KEY_PICKUP=офис ITB, 3 этаж, офис 307
KEY_RETURN=стойку ресепшена
ARRIVE_BEFORE_MIN=15
