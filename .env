# Рабочие настройки. Файл в git не попадает (.gitignore).

PORT=3000
# Адрес сайта снаружи: на него ЮKassa вернёт клиента после оплаты. Заменить на домен перед запуском.
BASE_URL=http://localhost:3000
STUDIO_NAME=I love stretch
# Зал в Омске (ул. Фрунзе, 1 к4)
STUDIO_TZ=Asia/Omsk

# Расписание и цены: 800 ₽ до 17:00, 1000 ₽ с 17:00 до 21:00
OPEN_HOUR=9
CLOSE_HOUR=21
PEAK_FROM=17
PRICE_DAY=800
PRICE_PEAK=1000
# Сколько минут держим слот, пока клиент на странице оплаты
HOLD_MINUTES=30
HORIZON_DAYS=60
MAX_HOURS=8
# Бронь блоками по столько часов (09–11, 11–13, …)
SLOT_HOURS=2

# Календарь. Переключить на google, когда ключ сервисного аккаунта будет лежать в secrets/
CALENDAR_DRIVER=memory
GOOGLE_CALENDAR_ID=de3d37fcfc754a7f554819540416bed48ca7633d0fc669f96fc4dfb940a8935b@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
PENDING_COLOR_ID=5
PAID_COLOR_ID=10
SWEEP_INTERVAL_SEC=300

# Оплата: yookassa (нужны ключи ниже), fake (имитация для разработки), transfer (перевод по реквизитам)
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1, если в магазине ЮKassa включены чеки (54-ФЗ)
YOOKASSA_RECEIPT=0
YOOKASSA_VAT_CODE=1

# Реквизиты: нужны только при PAYMENT_PROVIDER=transfer
REQUISITES_RECIPIENT=
REQUISITES_ACCOUNT=
REQUISITES_BANK=

# Письма (почта домена на Mail.ru)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=dt@itb-company.com
SMTP_PASS=9y33Wtz7gUWEo0ePnXO3
MAIL_FROM=I love stretch <dt@itb-company.com>
# Куда приходит «оплата прошла». Пусто — на ящик SMTP_USER
ADMIN_EMAIL=dt@itb-company.com

# Telegram администратора (пока пусто: сообщения печатаются в консоль)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TRUST_PROXY=0

# Инструкция в письме клиенту после оплаты
VENUE_ADDRESS=Омск, ул. Фрунзе, 1 корпус 4, 11 этаж, помещение 1131
VENUE_PHONE=8 913 658-19-00
KEY_PICKUP=офис ITB, 3 этаж, офис 307
KEY_RETURN=стойку ресепшена
ARRIVE_BEFORE_MIN=15
